package build
import mill._
import mill.scalalib._

object poseidon2Sponge extends SbtModule {
  def scalaVersion = "2.13.18"
  def chiselVersion = "7.13.0"
  def repoDir = super.moduleDir / os.up
  def moduleDir = repoDir / "operators" / "poseidon2-sponge"
  override def sources = Task.Sources(moduleDir / "src" / "main" / "scala",
    repoDir / "common" / "poseidon2" / "src" / "main" / "scala")
  override def scalacOptions = Seq("-language:reflectiveCalls", "-deprecation", "-feature", "-Xcheckinit")
  override def mvnDeps = Seq(mvn"org.chipsalliance::chisel:$chiselVersion")
  override def scalacPluginMvnDeps = Seq(mvn"org.chipsalliance:::chisel-plugin:$chiselVersion")
  object tool extends ScalaModule {
    def scalaVersion = poseidon2Sponge.scalaVersion
    def moduleDir = poseidon2Sponge.moduleDir
    override def sources = Task.Sources(moduleDir / "src" / "tool" / "scala")
    def moduleDeps = Seq(poseidon2Sponge)
  }
}
